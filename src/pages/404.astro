---
import BaseLayout from "@/layouts/BaseLayout.astro";

const pageTitle = "Page non trouvée (404) | zoho.les4h.fr";
---

<BaseLayout title={pageTitle} canonical="https://zoho.les4h.fr/404/">
  <section class="py-24 text-center px-6">
    <div class="mx-auto max-w-md">
      <span class="font-mono text-4xl font-extrabold text-accent-600 dark:text-accent-400">404</span>
      <h1 class="mt-4 text-2xl font-bold text-base-950 dark:text-white">
        Page introuvable
      </h1>
      <p class="mt-2 text-sm text-base-600 dark:text-base-400">
        La ressource que vous recherchez a été déplacée ou n'existe plus.
      </p>
      <div class="mt-6">
        <a
          href="/"
          class="inline-flex items-center rounded-xl bg-accent-600 px-5 py-2.5 text-xs font-semibold text-white shadow-sm hover:bg-accent-700 transition-colors"
        >
          Retour à l'accueil
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

