---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AUDIENCE_SEGMENTS } from "@/data/audiences";

const pageTitle = "Solutions Zoho par Secteur & Métier aux Antilles | LES4H";
const pageDesc = "Configurations Zoho adaptées aux commerces, BTP, services et tourisme en Guadeloupe, Martinique, Guyane et Saint-Martin. Découvrez nos cas concrets et flux métiers.";
---

<BaseLayout title={pageTitle} description={pageDesc} canonical="https://zoho.les4h.fr/audiences/">

  <!-- Hero Section Audiences -->
  <section class="py-16 lg:py-24 relative overflow-hidden border-b border-base-200 dark:border-base-900/60 bg-gradient-to-b from-white via-base-50/50 to-white dark:from-base-950 dark:via-base-900/30 dark:to-base-950">
    <div class="pointer-events-none absolute -top-40 -right-40 size-[500px] rounded-full bg-emerald-500/10 blur-3xl"></div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="max-w-3xl" data-aos="fade-up">
        <div class="inline-flex items-center gap-2 rounded-full px-3.5 py-1 text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 ring-1 ring-emerald-500/30">
          <span>Sur-mesure par industrie</span>
        </div>

        <h1 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-base-900 dark:text-white leading-[1.15]">
          Des solutions Zoho adaptées aux spécificités de chaque métier antillais
        </h1>

        <p class="mt-5 text-base sm:text-lg text-base-600 dark:text-base-300 leading-relaxed">
          Chaque secteur économique des Antilles fait face à des contraintes opérationnelles distinctes : logistique maritime, devis sur chantier, conformité fiscale ou saisonnalité touristique. Découvrez comment nous avons adapté l'écosystème Zoho à votre quotidien.
        </p>

        <!-- Quick Jump Buttons (Style LES4H) -->
        <div class="mt-8 flex flex-wrap gap-2">
          {AUDIENCE_SEGMENTS.map((seg) => (
            <a
              href={`#${seg.id}`}
              class="rounded-full border border-base-300 dark:border-base-800 bg-white/80 dark:bg-base-900/60 hover:bg-base-100 dark:hover:bg-base-800 px-4 py-2 text-xs font-semibold text-base-900 dark:text-white transition"
            >
              {seg.title.split(",")[0]}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Deep Dive by Segment -->
  <section class="py-16 border-b border-base-200/80 bg-base-50/50 dark:border-base-900/60 dark:bg-base-950">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 space-y-20">
      {AUDIENCE_SEGMENTS.map((seg) => (
        <div id={seg.id} class="scroll-mt-28" data-aos="fade-up">
          <div class="rounded-3xl border border-base-200 dark:border-base-800 bg-white dark:bg-base-900/60 p-8 md:p-12 shadow-sm hover:border-emerald-500/40 transition-all duration-300">
            
            <!-- Header of Segment -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-base-100 pb-6 dark:border-base-800">
              <div>
                <span class="inline-flex items-center rounded-full bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-emerald-800 dark:text-emerald-300 ring-1 ring-emerald-500/30">
                  {seg.badge}
                </span>
                <h2 class="mt-3 text-2xl md:text-3xl font-bold text-base-900 dark:text-white">
                  {seg.title}
                </h2>
                <p class="mt-1 text-sm font-medium text-emerald-700 dark:text-emerald-400">
                  {seg.subtitle}
                </p>
              </div>

              <div class="shrink-0">
                <a
                  href="/contact"
                  class="inline-flex items-center rounded-full bg-emerald-700 px-5 py-2.5 text-xs font-bold text-white hover:bg-emerald-800 transition-colors shadow-xs"
                >
                  Audit pour ce secteur &rarr;
                </a>
              </div>
            </div>

            <!-- Grid 2 cols: Challenges vs Solutions -->
            <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
              
              <!-- Left: Challenges & Context -->
              <div class="space-y-6">
                <div>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-red-600 dark:text-red-400">
                    Les défis concrets aux Antilles :
                  </h3>
                  <div class="mt-3 space-y-3">
                    {seg.painPoints.map((pp) => (
                      <div class="rounded-2xl bg-red-50/60 p-4 text-xs dark:bg-red-950/30 border border-red-200/50 dark:border-red-900/50">
                        <span class="font-bold text-red-900 dark:text-red-200 block mb-1">
                          {pp.problem}
                        </span>
                        <p class="text-red-800 dark:text-red-300 leading-relaxed">
                          {pp.reality}
                        </p>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="rounded-2xl bg-base-50 p-4 dark:bg-base-950 text-xs text-base-600 dark:text-base-400 italic border border-base-200/80 dark:border-base-800/80">
                  <strong class="font-semibold text-base-900 dark:text-white not-italic block mb-1">
                    L'éclairage de notre expert (12 ans de recul) :
                  </strong>
                  « {seg.localContext} »
                </div>
              </div>

              <!-- Right: Zoho Solution & Case Study -->
              <div class="space-y-6 flex flex-col justify-between">
                <div>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                    L'architecture logicielle déployée par LES4H :
                  </h3>
                  
                  <div class="mt-3 rounded-2xl border border-emerald-500/20 bg-emerald-50/40 p-5 dark:border-emerald-900/40 dark:bg-emerald-950/30">
                    <div class="font-bold text-sm text-base-900 dark:text-white">
                      {seg.zohoSolution.headline}
                    </div>
                    <p class="mt-1.5 text-xs text-base-600 dark:text-base-300 leading-relaxed">
                      {seg.zohoSolution.description}
                    </p>

                    <div class="mt-4 flex flex-wrap gap-1.5">
                      {seg.zohoSolution.recommendedApps.map((app) => (
                        <span class="rounded-md bg-white px-2.5 py-0.5 text-[11px] font-semibold text-base-800 dark:bg-base-900 dark:text-white shadow-xs border border-base-200 dark:border-base-700">
                          {app}
                        </span>
                      ))}
                    </div>

                    <ul class="mt-4 space-y-2 text-xs text-base-700 dark:text-base-300 pt-4 border-t border-emerald-500/20 dark:border-emerald-800/40">
                      {seg.zohoSolution.outcomes.map((out) => (
                        <li class="flex items-start gap-2">
                          <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
                          <span>{out}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <!-- Case Study Box -->
                <div class="rounded-2xl border border-base-200 bg-base-50 p-5 dark:border-base-800 dark:bg-base-950">
                  <div class="flex items-center justify-between text-xs">
                    <span class="font-bold text-base-900 dark:text-white">
                      Étude de cas · {seg.caseStudyExample.territory}
                    </span>
                    <span class="font-mono text-emerald-700 dark:text-emerald-400 font-bold">
                      {seg.caseStudyExample.metric}
                    </span>
                  </div>
                  <div class="mt-2 text-xs text-base-600 dark:text-base-400">
                    <span class="font-semibold">{seg.caseStudyExample.clientType}</span>
                  </div>
                  <p class="mt-2 text-[11px] text-base-500 leading-relaxed">
                    <strong class="text-base-700 dark:text-base-300">Avant :</strong> {seg.caseStudyExample.before}
                  </p>
                  <p class="mt-1 text-[11px] text-base-700 dark:text-base-300 leading-relaxed">
                    <strong class="text-emerald-700 dark:text-emerald-400">Avec Zoho :</strong> {seg.caseStudyExample.after}
                  </p>
                </div>

              </div>

            </div>

          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 text-center">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-2xl font-bold text-base-900 dark:text-white">
        Votre entreprise ne figure pas dans ces 4 catégories ?
      </h2>
      <p class="mt-3 text-sm text-base-600 dark:text-base-400 max-w-xl mx-auto">
        L'écosystème Zoho est modulaire et adaptable à presque toutes les activités (immobilier, santé, éducation, événementiel). Échangeons 30 minutes sur votre modèle.
      </p>
      <div class="mt-6">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-base-900 hover:bg-black dark:bg-white dark:text-base-950 dark:hover:bg-zinc-200 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:scale-[1.02]"
        >
          <span>Demander une étude personnalisée</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
