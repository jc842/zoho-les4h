---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ZOHO_ONE_DETAILS, ZOHO_CATEGORIES } from "@/data/solutions";
import { CONTACT } from "@/config/site";

const pageTitle = "Zoho One aux Antilles : L'ERP tout-en-un pour TPE et PME | LES4H";
const pageDesc = "Découvrez Zoho One en Guadeloupe, Martinique, Guyane et Saint-Martin. Plus de 45 applications intégrées pour 37 €/mois. Déploiement et accompagnement local LES4H.";
---

<BaseLayout title={pageTitle} description={pageDesc} canonical="https://zoho.les4h.fr/zoho-one/">
  
  <!-- Hero Section Zoho One -->
  <section class="py-16 lg:py-24 relative overflow-hidden">
    <div class="pointer-events-none absolute -top-40 -right-40 size-[500px] rounded-full bg-accent-500/10 blur-3xl"></div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="max-w-3xl" data-aos="fade-up">
        <div class="inline-flex items-center gap-2 rounded-full border border-accent-200 bg-accent-50/70 px-3.5 py-1 text-xs font-semibold text-accent-800 dark:border-accent-900 dark:bg-accent-950/70 dark:text-accent-300">
          <span>{ZOHO_ONE_DETAILS.badge}</span>
        </div>

        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-base-950 sm:text-5xl dark:text-white leading-[1.15]">
          {ZOHO_ONE_DETAILS.headline}
        </h1>

        <p class="mt-6 text-lg text-base-600 dark:text-base-300 leading-relaxed">
          {ZOHO_ONE_DETAILS.subheadline}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-xl bg-accent-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lg hover:bg-accent-700 transition-colors"
          >
            <span>Planifier mon audit Zoho One</span>
            <span class="ml-2">→</span>
          </a>
          <a
            href={`tel:${CONTACT.phoneE164}`}
            class="inline-flex items-center justify-center rounded-xl border border-base-300 bg-transparent px-5 py-3.5 text-sm font-medium text-base-700 hover:bg-base-100 dark:border-base-700 dark:text-base-300 dark:hover:bg-base-800 transition-colors"
          >
            Échanger avec un expert local
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Models Section -->
  <section class="py-16 border-t border-base-200 bg-base-50/50 dark:border-base-800 dark:bg-base-950/50">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto" data-aos="fade-up">
        <h2 class="text-3xl font-extrabold tracking-tight text-base-950 dark:text-white">
          Une tarification limpide et sans surprise
        </h2>
        <p class="mt-3 text-sm text-base-600 dark:text-base-400">
          Deux formules souples pour s'adapter à la taille de votre équipe et à votre modèle opérationnel aux Antilles.
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-8 lg:grid-cols-2 max-w-5xl mx-auto">
        {ZOHO_ONE_DETAILS.pricingModels.map((plan) => (
          <div class={`relative flex flex-col justify-between rounded-3xl border p-8 shadow-sm ${
            plan.popular
              ? "border-accent-500 bg-white ring-2 ring-accent-500/20 dark:bg-base-900"
              : "border-base-200 bg-white dark:border-base-800 dark:bg-base-900"
          }`}>
            {plan.popular && (
              <span class="absolute -top-3.5 left-8 rounded-full bg-accent-600 px-3 py-1 text-xs font-semibold text-white shadow-md">
                Recommandé pour 90% des TPE/PME
              </span>
            )}

            <div>
              <h3 class="text-xl font-bold text-base-950 dark:text-white">
                {plan.name}
              </h3>
              <p class="mt-2 text-xs text-base-600 dark:text-base-400">
                {plan.desc}
              </p>

              <div class="mt-6 flex items-baseline gap-2">
                <span class="text-4xl font-extrabold text-base-950 dark:text-white font-mono">
                  {plan.pricePerMonth}
                </span>
                <span class="text-xs text-base-500">
                  {plan.period}
                </span>
              </div>

              <ul class="mt-8 space-y-3 text-xs text-base-600 dark:text-base-300">
                {plan.highlights.map((h) => (
                  <li class="flex items-center gap-2.5">
                    <svg class="size-4 text-emerald-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                    </svg>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-8 pt-6 border-t border-base-100 dark:border-base-800">
              <a
                href="/contact"
                class={`block w-full rounded-xl py-3 text-center text-xs font-semibold transition-colors ${
                  plan.popular
                    ? "bg-accent-600 text-white hover:bg-accent-700 shadow-md"
                    : "border border-base-300 text-base-800 hover:bg-base-100 dark:border-base-700 dark:text-base-200 dark:hover:bg-base-800"
                }`}
              >
                {plan.ctaText} →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Complete Apps Ecosystem inside Zoho One -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center" data-aos="fade-up">
        <h2 class="text-3xl font-extrabold tracking-tight text-base-950 sm:text-4xl dark:text-white">
          Ce que comprend votre abonnement Zoho One
        </h2>
        <p class="mt-4 text-sm text-base-600 dark:text-base-400">
          Chaque application est un outil professionnel complet qui communique nativement avec tous les autres.
        </p>
      </div>

      <div class="mt-16 space-y-12">
        {ZOHO_CATEGORIES.map((cat) => (
          <div class="rounded-3xl border border-base-200 bg-white p-8 dark:border-base-800 dark:bg-base-900 shadow-sm">
            <h3 class="text-xl font-bold text-base-950 dark:text-white">
              {cat.name}
            </h3>
            <p class="text-xs text-base-500 mt-1">
              {cat.tagline}
            </p>

            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {cat.apps.map((app) => (
                <div class="rounded-2xl border border-base-100 bg-base-50/60 p-4 dark:border-base-800 dark:bg-base-950/60">
                  <div class="font-bold text-sm text-base-950 dark:text-white">
                    {app.name}
                  </div>
                  <div class="mt-1 text-xs font-medium text-accent-600 dark:text-accent-400">
                    {app.tagline}
                  </div>
                  <p class="mt-2 text-[11px] text-base-600 dark:text-base-400 leading-snug">
                    {app.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Local Deployment Promise -->
  <section class="py-16 bg-base-900 text-white dark:bg-base-950 border-t border-white/10">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center max-w-3xl">
      <h2 class="text-2xl font-bold sm:text-3xl">
        Comment nous déployons Zoho One pour vous
      </h2>
      <p class="mt-4 text-sm text-base-300 leading-relaxed">
        Nous n'installons pas un logiciel pour vous laisser seul avec un mode d'emploi. Nous paramétrons vos workflows, nous migrons vos bases historiques et nous formons vos salariés en Guadeloupe, Martinique, Guyane et Saint-Martin.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a
          href="/contact"
          class="rounded-xl bg-accent-500 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:bg-accent-400 transition-colors"
        >
          Demander une démonstration interactive
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

