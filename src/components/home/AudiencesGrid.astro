---
import { AUDIENCE_SEGMENTS } from "@/data/audiences";
---

<section id="audiences" class="py-20 border-t border-base-200/80 bg-base-50/50 dark:border-base-800/80 dark:bg-base-950/50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <div class="max-w-3xl mx-auto text-center" data-aos="fade-up">
      <span class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
        Solutions sectorielles ciblées
      </span>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-base-950 sm:text-4xl dark:text-white">
        Quel est votre métier aux Antilles ?
      </h2>
      <p class="mt-4 text-base text-base-600 dark:text-base-400">
        Découvrez les configurations Zoho spécifiquement pré-paramétrées pour répondre aux enjeux de votre secteur d'activité en Guadeloupe, Martinique, Guyane et Saint-Martin.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-2">
      {AUDIENCE_SEGMENTS.map((seg, idx) => (
        <div
          class="relative flex flex-col justify-between overflow-hidden rounded-3xl border border-base-200 bg-white p-8 shadow-sm transition hover:shadow-lg hover:border-accent-400/50 dark:border-base-800 dark:bg-base-900"
          data-aos="fade-up"
          data-aos-delay={idx * 100}
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="rounded-full bg-accent-100 px-3 py-1 text-xs font-semibold text-accent-800 dark:bg-accent-950 dark:text-accent-300">
                {seg.badge}
              </span>
              <span class="text-xs font-medium text-base-400">
                Cas concret Antilles
              </span>
            </div>

            <h3 class="mt-5 text-xl font-bold text-base-950 dark:text-white">
              {seg.title}
            </h3>
            <p class="mt-2 text-sm text-base-600 dark:text-base-300 font-medium">
              {seg.subtitle}
            </p>

            <!-- Pain points summary -->
            <div class="mt-5 rounded-2xl bg-base-50 p-4 dark:bg-base-950/70 border border-base-200/60 dark:border-base-800/60">
              <span class="text-xs font-semibold text-base-900 dark:text-white block mb-2">
                Enjeux quotidiens résolus :
              </span>
              <ul class="space-y-1.5 text-xs text-base-600 dark:text-base-400">
                {seg.painPoints.slice(0, 2).map((pp) => (
                  <li class="flex items-start gap-2">
                    <span class="text-red-500 font-bold shrink-0">✕</span>
                    <span><strong>{pp.problem} :</strong> {pp.reality}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Zoho Answer -->
            <div class="mt-5">
              <span class="text-xs font-semibold text-accent-600 dark:text-accent-400 uppercase tracking-wider block">
                La réponse Zoho LES4H :
              </span>
              <p class="mt-1 text-xs text-base-700 dark:text-base-300 font-medium">
                {seg.zohoSolution.headline}
              </p>
              
              <div class="mt-3 flex flex-wrap gap-1.5">
                {seg.zohoSolution.recommendedApps.map((app) => (
                  <span class="rounded-md border border-base-200 bg-base-100 px-2 py-0.5 text-[11px] font-medium text-base-700 dark:border-base-700 dark:bg-base-800 dark:text-base-300">
                    {app}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="mt-8 pt-5 border-t border-base-200 dark:border-base-800 flex items-center justify-between">
            <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">
              {seg.caseStudyExample.metric}
            </span>
            <a
              href={`/audiences#${seg.id}`}
              class="inline-flex items-center gap-1 text-xs font-semibold text-accent-600 hover:text-accent-700 dark:text-accent-400 dark:hover:text-accent-300 transition-colors"
            >
              <span>Voir le cas détaillé</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Audience link footer -->
    <div class="mt-12 text-center">
      <a
        href="/audiences"
        class="inline-flex items-center justify-center rounded-xl bg-base-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-base-800 dark:bg-white dark:text-base-950 dark:hover:bg-base-100 transition-colors"
      >
        <span>Consulter l'ensemble des études de cas par métier</span>
        <span class="ml-2">→</span>
      </a>
    </div>

  </div>
</section>

