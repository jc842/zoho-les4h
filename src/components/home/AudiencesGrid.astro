---
import { AUDIENCE_SEGMENTS } from "@/data/audiences";
---

<section id="audiences" class="py-20 border-b border-base-200/80 bg-base-50/50 dark:border-base-900/60 dark:bg-base-950">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <div class="max-w-2xl" data-aos="fade-up">
      <span class="text-xs uppercase tracking-widest font-bold text-emerald-600 dark:text-emerald-400">
        Solutions sectorielles ciblées
      </span>
      <h2 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-base-900 dark:text-white">
        Quel est votre métier aux Antilles ?
      </h2>
      <p class="mt-3 text-base text-base-600 dark:text-base-300">
        Découvrez les configurations Zoho spécifiquement pré-paramétrées pour répondre aux enjeux de votre secteur d'activité en Guadeloupe, Martinique, Guyane et Saint-Martin.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
      {AUDIENCE_SEGMENTS.map((seg, idx) => (
        <div
          class="relative flex flex-col justify-between rounded-3xl border border-base-200 dark:border-base-800 bg-white dark:bg-base-900/60 p-7 sm:p-8 hover:border-emerald-500/40 hover:shadow-xl transition-all duration-300"
          data-aos="fade-up"
          data-aos-delay={idx * 100}
        >
          <div>
            <!-- Top Row: Badge & Number -->
            <div class="flex items-center justify-between pb-4 border-b border-base-100 dark:border-base-800">
              <span class="inline-flex items-center rounded-full bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">
                {seg.badge}
              </span>
              <span class="text-sm font-black text-base-300 dark:text-base-700 font-mono">
                0{idx + 1}
              </span>
            </div>

            <h3 class="mt-4 text-xl font-bold text-base-900 dark:text-white leading-snug">
              {seg.title}
            </h3>
            <p class="mt-2 text-sm font-medium text-emerald-700 dark:text-emerald-400 leading-relaxed">
              {seg.subtitle}
            </p>

            <!-- Pain points summary -->
            <div class="mt-4 rounded-xl bg-base-50 dark:bg-base-950/60 p-3.5 text-xs text-base-600 dark:text-base-400 border border-base-100 dark:border-base-800">
              <span class="font-bold text-base-900 dark:text-base-200 block mb-2">
                Enjeux quotidiens résolus :
              </span>
              <ul class="space-y-1.5 text-xs text-base-600 dark:text-base-400">
                {seg.painPoints.slice(0, 2).map((pp) => (
                  <li class="flex items-start gap-2">
                    <span class="text-red-500 font-bold shrink-0">✕</span>
                    <span><strong>{pp.problem} :</strong> {pp.reality}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Zoho Answer -->
            <div class="mt-5">
              <span class="text-xs font-bold text-base-900 dark:text-white uppercase tracking-wider block">
                La réponse Zoho LES4H :
              </span>
              <p class="mt-1 text-xs text-emerald-800 dark:text-emerald-300 font-medium">
                {seg.zohoSolution.headline}
              </p>
              
              <div class="mt-3 flex flex-wrap gap-1.5">
                {seg.zohoSolution.recommendedApps.map((app) => (
                  <span class="rounded-md border border-base-200 bg-base-100 px-2 py-0.5 text-[11px] font-medium text-base-700 dark:border-base-700 dark:bg-base-800 dark:text-base-300">
                    {app}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="mt-6 pt-5 border-t border-base-100 dark:border-base-800 flex items-center justify-between">
            <span class="text-xs font-bold text-emerald-700 dark:text-emerald-400">
              {seg.caseStudyExample.metric}
            </span>
            <a
              href={`/audiences#${seg.id}`}
              class="inline-flex items-center gap-1.5 text-xs font-bold text-base-900 dark:text-white hover:text-emerald-600 dark:hover:text-emerald-400 transition"
            >
              <span>Voir le cas détaillé</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Audience link footer -->
    <div class="mt-12 text-center">
      <a
        href="/audiences"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-base-900 hover:bg-black dark:bg-white dark:text-base-950 dark:hover:bg-zinc-200 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:scale-[1.02]"
      >
        <span>Consulter l'ensemble des études de cas par métier</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

  </div>
</section>
