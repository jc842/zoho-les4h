---
import { Image } from "astro:assets";
import portrait from "@/images/portrait-vue-mer-guadeloupe.webp";
import { SITE, CONTACT } from "@/config/site";
import { ZOHO_ONE_DETAILS } from "@/data/solutions";
---

<section class="relative overflow-hidden border-b border-base-200 dark:border-base-900/60 bg-gradient-to-b from-white via-base-50/50 to-white dark:from-base-950 dark:via-base-900/30 dark:to-base-950 pt-12 pb-20 lg:pt-16 lg:pb-24">
  <!-- Subtle ambient glow background (identical to les4h.fr) -->
  <div class="pointer-events-none absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
    <div class="relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-emerald-500/20 to-teal-500/10 opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-12">
      
      <!-- Left Column: Copy & Value Proposition -->
      <div class="lg:col-span-7 space-y-6" data-aos="fade-up">
        
        <!-- Status Pill Badge (Style LES4H) -->
        <div class="inline-flex items-center gap-2.5 rounded-full px-3.5 py-1.5 text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 ring-1 ring-emerald-500/30 shadow-xs">
          <span class="flex size-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Agent Certifié Zoho depuis {SITE.experienceYears} ans</span>
          <span class="text-zinc-400 dark:text-zinc-600">·</span>
          <span class="text-zinc-600 dark:text-zinc-400 font-normal">Antilles (UTC-4)</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-base-900 dark:text-white text-balance leading-[1.15]">
          L'écosystème <span class="bg-gradient-to-r from-emerald-600 via-emerald-500 to-teal-500 bg-clip-text text-transparent">Zoho</span> taillé pour les entreprises des Antilles.
        </h1>

        <p class="text-base sm:text-lg text-base-600 dark:text-base-300 text-balance leading-relaxed">
          Finissez-en avec les logiciels éparpillés et les factures SaaS cumulées. Déployez <strong class="text-base-900 dark:text-white font-semibold">Zoho One</strong> et <strong class="text-base-900 dark:text-white font-semibold">Zoho CRM</strong> avec un partenaire local basé en Guadeloupe et Martinique, présent à vos côtés depuis 12 ans sans décalage horaire.
        </p>

        <!-- Bullet Highlights -->
        <ul class="space-y-2.5 text-sm text-base-600 dark:text-base-300">
          <li class="flex items-center gap-2.5">
            <svg class="size-4.5 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span><strong>Zoho One :</strong> 45+ applications métier unifiées pour 37 € / mois / employé.</span>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="size-4.5 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span><strong>Conformité locale :</strong> Paramétrage TVA 8.5%, exonérations Guyane/St-Martin et Octroi de mer.</span>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="size-4.5 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span><strong>Accompagnement de A à Z :</strong> Migration données (Excel, Sage), formation et support direct.</span>
          </li>
        </ul>

        <!-- Action CTAs (Exact LES4H Pill Styling) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-base-900 hover:bg-black dark:bg-white dark:text-base-950 dark:hover:bg-zinc-200 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:scale-[1.02] text-center"
          >
            <span>Réserver un diagnostic 30 min offert</span>
            <svg class="size-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </a>

          <a
            href="/zoho-one"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-base-300 dark:border-base-800 bg-white/80 dark:bg-base-900/60 hover:bg-base-100 dark:hover:bg-base-800 px-6 py-3.5 text-sm font-medium text-base-900 dark:text-white transition duration-200 text-center"
          >
            <span>Découvrir Zoho One en détail</span>
          </a>
        </div>

        <!-- Trust Stats Strip (Style LES4H) -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-base-200 dark:border-base-800/80">
          <div>
            <div class="text-2xl font-bold text-base-900 dark:text-white">12 ans</div>
            <div class="text-xs text-base-500 dark:text-base-400">Agent certifié Zoho</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-base-900 dark:text-white">45+ apps</div>
            <div class="text-xs text-base-500 dark:text-base-400">Dans Zoho One</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-base-900 dark:text-white">UTC-4</div>
            <div class="text-xs text-base-500 dark:text-base-400">Support local Antilles</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Visual Portrait with Microstudio Frame -->
      <div class="lg:col-span-5 relative" data-aos="fade-left">
        <div class="relative mx-auto max-w-md lg:max-w-none rounded-3xl overflow-hidden border border-base-200 dark:border-base-800 bg-white dark:bg-base-900/60 p-3 shadow-xl">
          <div class="overflow-hidden rounded-2xl">
            <Image
              src={portrait}
              alt="Jean-Christophe Hutin — Agent Zoho & CDO LES4H"
              width={480}
              height={560}
              loading="eager"
              class="aspect-4/5 w-full object-cover object-top filter grayscale contrast-105 transition-all duration-500 hover:grayscale-0 hover:scale-105"
            />
          </div>
          <!-- Card Footer Details -->
          <div class="mt-4 px-2 pb-1 flex items-center justify-between text-xs">
            <div>
              <div class="font-semibold text-base-900 dark:text-white">Jean-Christophe Hutin</div>
              <div class="text-base-500 dark:text-base-400">Agent Zoho & Fondateur LES4H</div>
            </div>
            <a
              href={`https://wa.me/${CONTACT.whatsappNumber}?text=${encodeURIComponent("Bonjour Jean-Christophe, je souhaite échanger sur Zoho.")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 dark:bg-emerald-950/80 px-3 py-1 font-semibold text-emerald-800 dark:text-emerald-300 hover:bg-emerald-200 dark:hover:bg-emerald-900 transition"
              title="Discuter directement sur WhatsApp"
            >
              <span class="size-1.5 rounded-full bg-emerald-500"></span>
              <span>WhatsApp</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
