---
const challenges = [
  {
    title: "Le piège du décalage horaire",
    problem: "5h à 6h de décalage avec la Métropole, 9h à 10h avec l'Asie.",
    solution: "Avec LES4H, vos formations, vos ateliers de cadrage et votre support ont lieu sur votre journée de travail en temps réel (UTC-4), en présentiel ou visio.",
    icon: "clock"
  },
  {
    title: "Fiscalité insulaire & Octroi de mer",
    problem: "Taux de TVA spécifiques (8.5%, 2.1%), exonérations Guyane/St-Martin et taxes portuaires.",
    solution: "Nos configurations Zoho Books & Inventory intègrent nativement vos modèles de facturation locale et le calcul précis de vos coûts de revient réels.",
    icon: "file-text"
  },
  {
    title: "La facture toxique des SaaS empilés",
    problem: "Payer 10 abonnements différents en dollars ou euros sans qu'aucun outil ne communique.",
    solution: "Zoho One regroupe CRM, facturation, stocks, support, signature électronique et RH dans une seule formule à 37 € / mois / salarié. Économie immédiate de 40% à 70%.",
    icon: "layers"
  },
  {
    title: "Accompagnement de terrain depuis 12 ans",
    problem: "Souscrire un logiciel en ligne sans personne pour former l'équipe ni migrer les fichiers Excel.",
    solution: "Jean-Christophe Hutin intervient directement auprès de vos collaborateurs : paramétrage sur-mesure, nettoyage de vos bases clients et prise en main durable.",
    icon: "shield-check"
  }
];
---

<section id="pourquoi-les4h" class="py-20 border-b border-base-200/80 bg-base-50/50 dark:border-base-900/60 dark:bg-base-950">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-2xl" data-aos="fade-up">
      <span class="text-xs uppercase tracking-widest font-bold text-emerald-600 dark:text-emerald-400">
        Pourquoi un intégrateur local aux Antilles ?
      </span>
      <h2 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-base-900 dark:text-white">
        Une solution pensée pour la réalité économique des Caraïbes
      </h2>
      <p class="mt-3 text-base text-base-600 dark:text-base-300">
        Entreprendre en Guadeloupe, en Martinique ou en Guyane comporte des spécificités que les éditeurs parisiens ou californiens ignorent. Voici pourquoi notre approche fait la différence.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {challenges.map((c, idx) => (
        <div
          class="flex flex-col justify-between rounded-3xl border border-base-200 dark:border-base-800 bg-white dark:bg-base-900/60 p-7 transition-all duration-300 hover:shadow-xl hover:border-emerald-500/40"
          data-aos="fade-up"
          data-aos-delay={idx * 100}
        >
          <div>
            <div class="inline-flex size-11 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-700 dark:bg-emerald-950/80 dark:text-emerald-300">
              {c.icon === "clock" && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
              )}
              {c.icon === "file-text" && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="16" y1="13" x2="8" y2="13" />
                  <line x1="16" y1="17" x2="8" y2="17" />
                  <polyline points="10 9 9 9 8 9" />
                </svg>
              )}
              {c.icon === "layers" && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="12 2 2 7 12 12 22 7 12 2" />
                  <polyline points="2 17 12 22 22 17" />
                  <polyline points="2 12 12 17 22 12" />
                </svg>
              )}
              {c.icon === "shield-check" && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  <polyline points="9 12 11 14 15 10" />
                </svg>
              )}
            </div>

            <h3 class="mt-4 text-base font-bold text-base-900 dark:text-white">
              {c.title}
            </h3>

            <div class="mt-2.5 rounded-xl bg-red-50 p-2.5 text-xs text-red-700 dark:bg-red-950/40 dark:text-red-300">
              <span class="font-semibold">Le problème :</span> {c.problem}
            </div>

            <p class="mt-3 text-xs leading-relaxed text-base-600 dark:text-base-400">
              {c.solution}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-base-100 dark:border-base-800 text-[11px] font-semibold text-emerald-700 dark:text-emerald-400 flex items-center justify-between">
            <span>Garanti par LES4H</span>
            <span>✓</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
