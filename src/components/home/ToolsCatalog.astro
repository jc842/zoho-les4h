---
import { ZOHO_CATEGORIES } from "@/data/solutions";
---

<section id="solutions" class="py-24 border-b border-base-200 dark:border-base-900/60 bg-white dark:bg-base-950">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <div class="max-w-2xl" data-aos="fade-up">
      <span class="text-xs uppercase tracking-widest font-bold text-emerald-600 dark:text-emerald-400">
        Catalogue modulaire
      </span>
      <h2 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-base-900 dark:text-white">
        Les outils Zoho par fonction d'entreprise
      </h2>
      <p class="mt-3 text-base text-base-600 dark:text-base-300">
        Que vous souhaitiez démarrer avec un seul outil ciblé (ex. Zoho CRM ou Zoho Books) ou unifier l'ensemble de votre organisation avec Zoho One, voici les briques majeures.
      </p>
    </div>

    <!-- Category Loops -->
    <div class="mt-14 space-y-16">
      {ZOHO_CATEGORIES.map((cat, catIdx) => (
        <div id={cat.id} class="scroll-mt-24" data-aos="fade-up">
          <div class="border-b border-base-200 pb-4 dark:border-base-800 flex flex-col md:flex-row md:items-end justify-between gap-2">
            <div>
              <span class="text-xs font-mono font-bold uppercase text-emerald-600 dark:text-emerald-400 tracking-wider">
                Module 0{catIdx + 1}
              </span>
              <h3 class="text-2xl font-bold text-base-900 dark:text-white mt-1">
                {cat.name}
              </h3>
            </div>
            <p class="text-xs text-base-500 dark:text-base-400 max-w-md">
              {cat.tagline}
            </p>
          </div>

          <!-- Apps Grid in this category -->
          <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {cat.apps.map((app) => (
              <div class="flex flex-col justify-between rounded-3xl border border-base-200 dark:border-base-800 bg-white dark:bg-base-900/60 p-6 shadow-sm transition-all duration-300 hover:shadow-xl hover:border-emerald-500/40">
                <div>
                  <div class="flex items-center justify-between">
                    <span class="font-bold text-base-900 dark:text-white text-base">
                      {app.name}
                    </span>
                    {app.featured && (
                      <span class="inline-flex items-center rounded-full bg-emerald-50 dark:bg-emerald-950/60 px-2.5 py-0.5 text-[10px] font-bold text-emerald-800 dark:text-emerald-300 ring-1 ring-emerald-500/30">
                        Phare
                      </span>
                    )}
                  </div>
                  
                  <p class="mt-2 text-xs font-semibold text-emerald-700 dark:text-emerald-400">
                    {app.tagline}
                  </p>
                  
                  <p class="mt-2.5 text-xs text-base-600 dark:text-base-400 leading-relaxed">
                    {app.description}
                  </p>

                  <!-- Local Antilles benefit box -->
                  <div class="mt-4 rounded-xl bg-base-50 p-3 text-[11px] text-base-700 dark:bg-base-950 dark:text-base-300 border border-base-100 dark:border-base-800">
                    <span class="font-bold text-emerald-700 dark:text-emerald-400">Atout Antilles :</span> {app.antillesBenefit}
                  </div>
                </div>

                <div class="mt-5 pt-3 border-t border-base-100 dark:border-base-800 text-[11px] text-base-400 flex items-center justify-between">
                  <span>Remplace : {app.replaces[0]}</span>
                  <a href="/contact" class="font-bold text-emerald-700 dark:text-emerald-400 hover:underline">Démo →</a>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
