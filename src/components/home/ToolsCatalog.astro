---
import { ZOHO_CATEGORIES } from "@/data/solutions";
---

<section id="solutions" class="py-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <div class="max-w-3xl mx-auto text-center" data-aos="fade-up">
      <span class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
        Catalogue modulaire
      </span>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-base-950 sm:text-4xl dark:text-white">
        Les outils Zoho par fonction d'entreprise
      </h2>
      <p class="mt-4 text-base text-base-600 dark:text-base-400">
        Que vous souhaitiez démarrer avec un seul outil ciblé (ex. Zoho CRM ou Zoho Books) ou unifier l'ensemble de votre organisation avec Zoho One, voici les briques majeures.
      </p>
    </div>

    <!-- Category Loops -->
    <div class="mt-16 space-y-16">
      {ZOHO_CATEGORIES.map((cat, catIdx) => (
        <div id={cat.id} class="scroll-mt-24" data-aos="fade-up">
          <div class="border-b border-base-200 pb-4 dark:border-base-800 flex flex-col md:flex-row md:items-end justify-between gap-2">
            <div>
              <span class="text-xs font-mono font-semibold uppercase text-accent-600 dark:text-accent-400 tracking-wider">
                Module {catIdx + 1}
              </span>
              <h3 class="text-2xl font-bold text-base-950 dark:text-white mt-1">
                {cat.name}
              </h3>
            </div>
            <p class="text-xs text-base-500 dark:text-base-400 max-w-md">
              {cat.tagline}
            </p>
          </div>

          <!-- Apps Grid in this category -->
          <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {cat.apps.map((app) => (
              <div class="flex flex-col justify-between rounded-2xl border border-base-200 bg-white p-5 shadow-sm transition hover:shadow-md hover:border-accent-300 dark:border-base-800 dark:bg-base-900">
                <div>
                  <div class="flex items-center justify-between">
                    <span class="font-bold text-base-950 dark:text-white text-base">
                      {app.name}
                    </span>
                    {app.featured && (
                      <span class="rounded-full bg-accent-100 px-2 py-0.5 text-[10px] font-bold text-accent-800 dark:bg-accent-950 dark:text-accent-300">
                        Phare
                      </span>
                    )}
                  </div>
                  
                  <p class="mt-2 text-xs font-semibold text-accent-600 dark:text-accent-400">
                    {app.tagline}
                  </p>
                  
                  <p class="mt-2.5 text-xs text-base-600 dark:text-base-400 leading-relaxed">
                    {app.description}
                  </p>

                  <!-- Local Antilles benefit box -->
                  <div class="mt-4 rounded-xl bg-base-50 p-2.5 text-[11px] text-base-700 dark:bg-base-950 dark:text-base-300 border border-base-100 dark:border-base-800">
                    <span class="font-semibold text-emerald-600 dark:text-emerald-400">Atout Antilles :</span> {app.antillesBenefit}
                  </div>
                </div>

                <div class="mt-5 pt-3 border-t border-base-100 dark:border-base-800 text-[10px] text-base-400 flex items-center justify-between">
                  <span>Remplace : {app.replaces[0]}</span>
                  <a href="/contact" class="font-semibold text-accent-600 hover:underline">Démo →</a>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

