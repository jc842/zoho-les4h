---
import Logo from "@/components/assets/Logo.astro";
import ThemeToggle from "@/components/assets/ThemeToggle.astro";
import { CONTACT } from "@/config/site";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navItems = [
  { href: "/", label: "Accueil" },
  { href: "/zoho-one", label: "Zoho One (ERP Tout-en-un)" },
  { href: "/zoho-crm", label: "Zoho CRM & Ventes" },
  { href: "/audiences", label: "Solutions par Métier aux Antilles" },
  { href: "/#solutions", label: "Toutes les Suites Logicielles" },
  { href: "/contact", label: "Diagnostic 30 min Offert" },
];
---

<header class="sticky top-0 z-40 flex items-center justify-between border-b border-base-200 bg-white/90 px-4 py-3.5 backdrop-blur-md dark:border-base-800 dark:bg-base-950/90 lg:hidden">
  <div class="flex items-center gap-3">
    <Logo class="w-32" badge="Solutions Zoho" href="/" />
  </div>

  <div class="flex items-center gap-2">
    <ThemeToggle />
    <a
      href="/contact"
      class="rounded-full bg-emerald-700 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-emerald-800 transition-colors"
    >
      Audit 30 min
    </a>
    <button
      id="mobile-menu-btn"
      type="button"
      class="inline-flex size-9 items-center justify-center rounded-lg border border-base-200 text-base-700 dark:border-base-800 dark:text-base-300 hover:bg-base-100 dark:hover:bg-base-900"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <svg id="menu-icon-open" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div
  id="mobile-menu"
  class="hidden fixed inset-x-0 top-[57px] bottom-0 z-40 bg-white/95 backdrop-blur-lg px-6 py-6 overflow-y-auto dark:bg-base-950/95 border-b border-base-200 dark:border-base-800 lg:hidden"
>
  <div class="mb-4 rounded-2xl border border-emerald-500/20 bg-emerald-50/60 p-3 text-xs dark:border-emerald-900/40 dark:bg-emerald-950/50">
    <span class="font-semibold text-emerald-800 dark:text-emerald-300">Agent Zoho · 12 ans d'expérience</span>
    <p class="text-[11px] text-base-600 dark:text-base-400 mt-0.5">Accompagnement de proximité en Guadeloupe, Martinique, Guyane & St-Martin.</p>
  </div>

  <nav class="space-y-1.5">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block rounded-xl px-3 py-2.5 text-base font-medium text-base-800 hover:bg-base-100 dark:text-base-200 dark:hover:bg-base-900"
      >
        {item.label}
      </a>
    ))}
  </nav>

  <div class="mt-8 pt-6 border-t border-base-200 dark:border-base-800 space-y-3">
    <a
      href="/contact"
      class="block w-full rounded-full bg-emerald-700 py-3 text-center text-sm font-semibold text-white shadow-md hover:bg-emerald-800"
    >
      Réserver mon Diagnostic 30 min offert
    </a>
    <a
      href={`tel:${CONTACT.phoneE164}`}
      class="block w-full rounded-full border border-base-300 py-3 text-center text-sm font-medium text-base-700 dark:border-base-700 dark:text-base-300"
    >
      Appeler le {CONTACT.phoneDisplay}
    </a>
  </div>
</div>

<script is:inline>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (menuBtn && menu) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', !isExpanded);
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }
</script>
