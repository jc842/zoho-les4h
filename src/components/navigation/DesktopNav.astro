---
import Logo from "@/components/assets/Logo.astro";
import ThemeToggle from "@/components/assets/ThemeToggle.astro";
import { CONTACT, SITE } from "@/config/site";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navItems = [
  { href: "/", label: "Accueil", icon: "home" },
  { href: "/zoho-one", label: "Zoho One (ERP)", badge: "Star TPE/PME", icon: "sparkles" },
  { href: "/zoho-crm", label: "Zoho CRM & Ventes", icon: "trending-up" },
  { href: "/audiences", label: "Solutions par Métier", badge: "Antilles", icon: "briefcase" },
  { href: "/#solutions", label: "Toutes les Suites", icon: "grid" },
  { href: "/contact", label: "Audit & Contact", icon: "calendar" },
];

function isActive(href: string): boolean {
  if (href === "/" && (currentPath === "/" || currentPath === "")) return true;
  if (href !== "/" && currentPath.startsWith(href)) return true;
  return false;
}
---

<aside class="z-50 hidden bg-white dark:bg-base-950 lg:fixed lg:inset-y-0 lg:flex lg:w-64 lg:flex-col border-r border-base-200/60 dark:border-base-800/60">
  <div class="relative flex min-h-0 flex-1 flex-col">
    <!-- Header: Logo & Theme -->
    <div class="flex flex-1 flex-col overflow-y-auto px-6 pt-7 pb-4">
      <div class="flex items-start justify-between">
        <Logo class="w-40" badge="Solutions Zoho" href="/" />
        <ThemeToggle />
      </div>

      <!-- Trust Badge 12 ans -->
      <div class="mt-6 rounded-xl border border-accent-200/50 bg-accent-50/50 p-3 text-xs dark:border-accent-900/50 dark:bg-accent-950/40">
        <div class="flex items-center gap-2 font-semibold text-accent-700 dark:text-accent-300">
          <svg class="size-4 text-accent-600 dark:text-accent-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
          </svg>
          <span>Agent Zoho · 12 ans</span>
        </div>
        <p class="mt-1 text-[11px] text-base-600 dark:text-base-400 leading-snug">
          Guadeloupe, Martinique, Guyane & Saint-Martin. Support direct UTC-4.
        </p>
      </div>

      <!-- Navigation links -->
      <nav class="mt-7 flex-1 space-y-1">
        <div class="px-2 pb-2 text-[10px] font-semibold uppercase tracking-widest text-base-400 dark:text-base-500">
          Navigation
        </div>
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class={`group flex items-center justify-between rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
                active
                  ? "bg-accent-50 text-accent-700 dark:bg-accent-950/70 dark:text-accent-300 font-semibold"
                  : "text-base-600 hover:bg-base-100 hover:text-base-950 dark:text-base-400 dark:hover:bg-base-900 dark:hover:text-white"
              }`}
            >
              <span class="flex items-center gap-2.5">
                {item.label}
              </span>
              {item.badge && (
                <span class={`rounded-full px-2 py-0.5 text-[10px] font-semibold ${
                  active
                    ? "bg-accent-200 text-accent-800 dark:bg-accent-800 dark:text-accent-100"
                    : "bg-base-200 text-base-700 dark:bg-base-800 dark:text-base-300 group-hover:bg-accent-100 group-hover:text-accent-800"
                }`}>
                  {item.badge}
                </span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- CTA Box -->
      <div class="mt-6 rounded-2xl border border-base-200 bg-base-50 p-4 text-center dark:border-base-800 dark:bg-base-900/60">
        <h4 class="text-xs font-semibold text-base-900 dark:text-white">
          Diagnostic Zoho Offert
        </h4>
        <p class="mt-1 text-[11px] text-base-500 dark:text-base-400">
          30 min de cadrage pour évaluer vos processus et votre ROI.
        </p>
        <a
          href="/contact"
          class="mt-3 block w-full rounded-lg bg-accent-600 px-3 py-2 text-center text-xs font-semibold text-white shadow-sm hover:bg-accent-700 transition-colors"
        >
          Réserver mon audit
        </a>
      </div>

      <!-- Quick Contact Info -->
      <div class="mt-4 pt-3 border-t border-base-200 dark:border-base-800/80 text-[11px] text-base-500 space-y-1">
        <div class="flex items-center justify-between">
          <span>Téléphone :</span>
          <a href={`tel:${CONTACT.phoneE164}`} class="font-medium text-base-800 dark:text-base-300 hover:text-accent-500">
            {CONTACT.phoneDisplay}
          </a>
        </div>
        <div class="flex items-center justify-between">
          <span>Fuseau :</span>
          <span class="font-mono text-emerald-600 dark:text-emerald-400 font-semibold">UTC-4 (Caraïbes)</span>
        </div>
      </div>
    </div>
  </div>
</aside>

