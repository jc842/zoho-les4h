---
import ToggleLocalStorage from "../scripts/ToggleLocalStorage.astro";
import { SITE, CONTACT } from "@/config/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  lang?: string;
  schema?: object;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonical = Astro.url.href,
  image = "/og-default.jpg",
  lang = "fr",
  schema,
} = Astro.props;

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://zoho.les4h.fr/#organization",
  name: "LES4H · Solutions Zoho Antilles",
  url: "https://zoho.les4h.fr",
  description: description,
  image: "https://zoho.les4h.fr/og-default.jpg",
  logo: "https://zoho.les4h.fr/favicon.png",
  telephone: CONTACT.phoneE164,
  email: CONTACT.email,
  founder: {
    "@type": "Person",
    name: "Jean-Christophe Hutin",
    jobTitle: "Agent Zoho & CDO",
  },
  address: {
    "@type": "PostalAddress",
    addressRegion: "Guadeloupe",
    addressCountry: "GP",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 16.25,
    longitude: -61.55,
  },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Guadeloupe" },
    { "@type": "AdministrativeArea", name: "Martinique" },
    { "@type": "AdministrativeArea", name: "Saint-Martin" },
    { "@type": "AdministrativeArea", name: "Saint-Barthélemy" },
    { "@type": "AdministrativeArea", name: "Guyane" },
  ],
  knowsAbout: [
    "Zoho One",
    "Zoho CRM",
    "Zoho Books",
    "ERP TPE PME",
    "Intégrateur Zoho Antilles",
    "Facturation électronique Guadeloupe Martinique",
    "Automatisation d'entreprise",
  ],
  sameAs: [
    "https://www.linkedin.com/company/les4hcdo",
    "https://www.facebook.com/les4hcdo",
    "https://www.youtube.com/@les4hcdo",
  ],
  parentOrganization: {
    "@type": "Organization",
    name: "LES4H",
    url: "https://les4h.fr",
  },
};

const jsonLd = schema ?? defaultSchema;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<link rel="canonical" href={canonical} />
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<meta name="robots" content="index, follow, max-image-preview:large" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="fr_FR" />
<meta name="geo.region" content="GP" />
<meta name="geo.placename" content="Guadeloupe" />
<meta name="geo.position" content="16.25;-61.55" />
<meta name="ICBM" content="16.25, -61.55" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0b0b0b" />

<!-- Fonts & Styles -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap"
  rel="stylesheet"
/>
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

<ToggleLocalStorage />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

