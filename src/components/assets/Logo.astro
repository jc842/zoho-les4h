---
import { Image } from "astro:assets";
import logoDark from "@/images/les4h-dark.webp";
import logoWhite from "@/images/les4h-white.webp";

interface Props {
  class?: string;
  badge?: string;
  href?: string;
}

const { class: className = "w-44", badge = "Solutions Zoho", href = "/" } = Astro.props;
---
<a href={href} class="group inline-flex flex-col gap-1.5" aria-label="LES4H Solutions Zoho">
  <span class={`block ${className}`}>
    <Image
      src={logoDark}
      alt="LES4H"
      width={248}
      height={102}
      class="h-auto w-full object-contain dark:hidden"
      loading="eager"
    />
    <Image
      src={logoWhite}
      alt="LES4H"
      width={248}
      height={102}
      class="hidden h-auto w-full object-contain dark:block"
      loading="eager"
    />
  </span>
  {badge && (
    <span class="inline-flex items-center gap-1.5 font-mono text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-emerald-700 dark:text-emerald-400">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
      {badge}
    </span>
  )}
</a>
