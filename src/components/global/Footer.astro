---
import Logo from "@/components/assets/Logo.astro";
import { SITE, CONTACT, SUBSITES, SOCIAL } from "@/config/site";

const currentYear = new Date().getFullYear();
---

<footer class="mt-24 border-t border-base-200 bg-base-50/50 py-16 dark:border-base-800 dark:bg-base-950/50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-5">
      <!-- Col 1: Identity & Expert -->
      <div class="lg:col-span-2">
        <Logo class="w-48" badge="Solutions Zoho · Antilles" href="/" />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-base-600 dark:text-base-400">
          Agent et intégrateur certifié Zoho depuis {SITE.experienceYears} ans en Guadeloupe, Martinique, Saint-Martin et Guyane.
          L'expertise locale pour structurer, automatiser et rentabiliser votre entreprise sur le fuseau Caraïbes (UTC-4).
        </p>

        <div class="mt-6 flex flex-col gap-2.5 text-sm text-base-600 dark:text-base-400">
          <div class="flex items-center gap-2">
            <svg class="size-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <a href={`tel:${CONTACT.phoneE164}`} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors font-medium">
              {CONTACT.phoneDisplay}
            </a>
          </div>
          <div class="flex items-center gap-2">
            <svg class="size-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
            <a href={`mailto:${CONTACT.email}`} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors font-medium">
              {CONTACT.email}
            </a>
          </div>
          <div class="flex items-center gap-2 text-xs text-base-500 pt-1">
            <span class="inline-block size-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Support de proximité actif · Fuseau horaire UTC-4</span>
          </div>
        </div>
      </div>

      <!-- Col 2: Solutions Zoho -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-base-900 dark:text-white">
          Solutions Zoho
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm text-base-600 dark:text-base-400">
          <li>
            <a href="/zoho-one" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              Zoho One (ERP 45+ apps)
            </a>
          </li>
          <li>
            <a href="/zoho-crm" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              Zoho CRM & Bigin
            </a>
          </li>
          <li>
            <a href="/#finance" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              Facturation & TVA locale (Books)
            </a>
          </li>
          <li>
            <a href="/#operations" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              Signature électronique (Sign)
            </a>
          </li>
          <li>
            <a href="/#marketing" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              Marketing & Campagnes
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Par Métier / Audience -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-base-900 dark:text-white">
          Par Métier aux Antilles
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm text-base-600 dark:text-base-400">
          <li>
            <a href="/audiences#retail-distribution" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              Commerce & Import-Export
            </a>
          </li>
          <li>
            <a href="/audiences#services-consulting" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              Sociétés de Services & Conseil
            </a>
          </li>
          <li>
            <a href="/audiences#tourism-hospitality" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              Tourisme & Hébergement
            </a>
          </li>
          <li>
            <a href="/audiences#construction-field-services" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              BTP, Artisans & Terrain
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors font-bold text-emerald-700 dark:text-emerald-400">
              Audit 30 min offert &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Écosystème LES4H -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-base-900 dark:text-white">
          Groupe LES4H
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm text-base-600 dark:text-base-400">
          {SUBSITES.map((sub) => (
            <li>
              <a
                href={sub.href}
                target="_blank"
                rel="noopener"
                class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-1"
              >
                <span>{sub.label}</span>
                <svg class="size-3 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom line -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-base-200 pt-8 text-xs text-base-500 dark:border-base-800 md:flex-row">
      <p>© {currentYear} LES4H · Tous droits réservés. Guadeloupe, Martinique, Saint-Martin, Saint-Barthélemy, Guyane.</p>
      <div class="flex items-center gap-6">
        <a href="/mentions-legales" class="hover:underline">Mentions légales</a>
        <a href="/mentions-legales#confidentialite" class="hover:underline">Confidentialité</a>
        <div class="flex items-center gap-3">
          {SOCIAL.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="hover:text-base-900 dark:hover:text-white transition-colors" aria-label={s.name}>
              {s.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
